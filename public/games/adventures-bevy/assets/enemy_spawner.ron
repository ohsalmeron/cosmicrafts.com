// Single source of enemy spawn. Edit and restart to apply.
// When enabled: true, stress_spawn maintains target_enemies.
// pack_cluster_radius > 0: spawns form weighted packs (pack_themes / hero_pool) vs lone_wolf_pool.
(
    use_random: false,
    max_speed: Some((min: 15.0, max: 40.0)),
    acceleration: Some((min: 0.25, max: 3.0)),
    rotation_speed: Some((min: 5.0, max: 15.0)),
    range: Some((min: 2.5, max: 35.0)),
    cooldown: Some((min: 0.5, max: 2.25)),
    bullet_speed: Some((min: 30.0, max: 90.0)),
    damage: Some((min: 8, max: 64)),
    health: Some((min: 440, max: 1700)),
    shield: Some((min: 240, max: 1600)),
    scale: Some((min: 4.0, max: 12.0)),
    config: (
        enabled: true,
        target_enemies: 500,
        spawn_per_frame: 5,
        wave_shop_enemy_despawn_per_frame: None,
        min_distance: 50.0,
        max_distance: 4000.0,
        enemy_handicap: 10,
        enemy_thrusters: false,
        hero_pool: ["aurora", "juggernaut", "tempest", "voyager", "rusty"],
        ability_substitute_pool: ["missile", "orb", "spawn_drone", "bullet", "burst", "shockwave", "dash"],
        behavior_pool: ["default"],
        // Piñatas should wander or stay around until attacked.
        detection_range: Some(50.0),
        preferred_range: Some(16.0),
        activation_radius: Some(400.0),
        recycle_distance: 2500.0,
        contested_zone_bonus: 1.0,
        pack_cluster_radius: 120.0,
        pack_spawn_weight: 1.0,
        lone_wolf_spawn_weight: 0.0,
        lone_wolf_pool: [],
        lone_wolf_min_distance: None,
        lone_wolf_max_distance: None,
        default_pack_size_min: 15,
        default_pack_size_max: 45,
        avoid_repeat_pack_theme: false,
        pack_themes: [
            (
                weight: 1.0,
                unit_weights: [
                    (id: "sunfire_tick", weight: 6.0),
                    (id: "sunfire_needle", weight: 2.0),
                    (id: "tempest_dagger", weight: 1.0),
                ],
                pack_size_min: 18,
                pack_size_max: 32,
                cluster_radius_scale: 1.0,
                behavior_pool_override: Some(["default"]),
                force_profile_override: None,
            ),
            (
                weight: 0.65,
                unit_weights: [
                    (id: "sunfire_ripper", weight: 2.0),
                    (id: "sunfire_comet", weight: 3.0),
                    (id: "warden_sentry", weight: 1.0),
                ],
                pack_size_min: 10,
                pack_size_max: 20,
                cluster_radius_scale: 0.75,
                behavior_pool_override: Some(["default"]),
                force_profile_override: None,
            ),
        ],
    ),
)
