// Shield impact VFX (fresnel rim when projectiles hit shield).
// regen_delay_after_hit_secs: time out of combat before shield can regen (Protoss-style, we use 1.5s).
// impact_texture: optional texture (e.g. sprites/shield.webp) modulated with fresnel/emissive; None = procedural only.
(
    emissive_color: (0.1, 0.2, 0.7, 5000.0),
    fresnel_power: 0.01,
    shader: "shaders/shield_impact.wgsl",
    impact_texture: Some("sprites/shield.webp"),
    regen_delay_after_hit_secs: 1.5,
    impact_base_scale: 1.45,
    impact_duration_min: 0.45,
    impact_duration_max: 0.75,
    peak_alpha: 0.75,
    noise_scale: 8.0,
    noise_speed: 2.0,
    noise_amount: 0.0,
    rim_erode_alpha: 0.0,
)
