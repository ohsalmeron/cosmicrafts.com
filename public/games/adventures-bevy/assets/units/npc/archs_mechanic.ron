    bullet_visual_overrides: None,
    metadata: (
        display_name: "Archs Engineer",
        description_short: "A Archs Engineer roaming the sector.",
        tags: ["npc", "mechanic", "archs"],
        ui_color_hint: Some((0.6, 0.1, 0.15)),
    ),
    dialogue: Some((
        greetings: [
            "*deep clicking* Organic vessel... damaged. The Swarm can regenerate.",
            "Bio-repair available. AETH sustains the growth enzyme production.",
            "*chittering* Hull breaches detected. Chitin plating available for grafting.",
        ],
        farewells: [
            "The carapace holds. Do not damage the grafts.",
            "*clicking subsides* Return if it fails.",
            "Swarm-work guaranteed for sixty standard cycles.",
        ],
        purposes: [
            (
                label: "Bio-Graft Repair - 150 AETH",
                value: "mechanic_repair",
                action: "mechanic_repair",
                responses_success: [
                    "*clicking intensifies* Bio-grafts applied. Hull sealed with chitinous plating.",
                    "The Swarm's flesh mends your metal. Organic-mechanical bond: secure.",
                    "Regeneration complete. The hull will breathe slightly now. This is normal.",
                ],
                responses_fail: [
                    "Insufficient nutrients. The Swarm cannot regenerate without AETH.",
                    "*angry clicking* No fuel. No repair. Simple equation.",
                ],
            ),
            (
                label: "Trade Bio-Components",
                value: "trade",
                action: "open_trade",
                responses_success: [
                    "The Swarm has surplus organic components. Most are functional.",
                    "Bio-repair kits. Guaranteed to... mostly work.",
                ],
                responses_fail: [
                ],
            ),
            (
                label: "Leave the bio-nest",
                value: "leave",
                action: "close",
                responses_success: [
                    "The Swarm notes your hull weakness. It will worsen.",
                    "Structural failure: imminent. Your problem.",
                ],
                responses_fail: [
                ],
            ),
        ],
    )),
