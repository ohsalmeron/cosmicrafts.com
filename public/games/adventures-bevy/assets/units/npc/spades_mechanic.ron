    bullet_visual_overrides: None,
    metadata: (
        display_name: "Spade Engineer",
        description_short: "A Spade Engineer roaming the sector.",
        tags: ["npc", "mechanic", "spades"],
        ui_color_hint: Some((0.6, 0.1, 0.8)),
    ),
    dialogue: Some((
        greetings: [
            "Your ship reeks of battle damage. I can fix it — if you can stomach my methods.",
            "The Nethereum forges can repair anything. The cost is AETH and your blissful ignorance.",
            "Broken hull? I'll weld it with hellfire. It's more durable than you'd think.",
        ],
        farewells: [
            "Don't look too closely at the welds.",
            "She'll fly. That's all that matters in the void.",
            "Come back when it breaks again. It will.",
        ],
        purposes: [
            (
                label: "Hellfire Repair - 150 AETH",
                value: "mechanic_repair",
                action: "mechanic_repair",
                responses_success: [
                    "Welded with hellfire. She'll hold — or explode gloriously.",
                    "Repairs complete. The screaming from the hull is totally normal.",
                    "Fixed. Don't ask what I used for sealant.",
                ],
                responses_fail: [
                    "No AETH, no hellfire. The forges demand fuel.",
                    "Return with coin. The darkness doesn't work for free.",
                ],
            ),
            (
                label: "Cursed Components",
                value: "trade",
                action: "open_trade",
                responses_success: [
                    "Nethereum-forged parts. Very durable. Slight side effects.",
                    "Cursed components. Extremely tough. Use at your own risk.",
                ],
                responses_fail: [
                ],
            ),
            (
                label: "I'll live with the damage",
                value: "leave",
                action: "close",
                responses_success: [
                    "Fly apart for all I care.",
                    "The void will claim your wreck eventually. It always does.",
                ],
                responses_fail: [
                ],
            ),
        ],
    )),
)
