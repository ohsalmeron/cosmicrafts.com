    dialogue: Some((
        greetings: [
            "The Spiral weeps to see such damage to your vessel, traveler.",
            "Your ship's wounds disturb the cosmic balance. Allow me to restore it.",
            "The Ethereum can mend what conflict has broken. Do you have an offering?",
        ],
        farewells: [
            "May the Light keep your hull intact.",
            "Fly with the Spiral's blessing, restored and whole.",
            "Return if the darkness scratches you again.",
