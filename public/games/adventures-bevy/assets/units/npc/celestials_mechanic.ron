        purposes: [
            (
                label: "Spiritual Repair - 150 AETH",
                value: "mechanic_repair",
                action: "mechanic_repair",
                responses_success: [
                    "The Light has mended your vessel. Fly in peace.",
                    "The Spiral's grace restores what was broken.",
                    "Your ship shines anew with the Ethereum's blessing.",
                ],
                responses_fail: [
                    "The Light requires tribute to flow. Return with AETH.",
                    "Without an offering, the Spiral cannot mend what combat has broken.",
                ],
            ),
            (
                label: "Browse Sacred Parts",
                value: "trade",
                action: "open_trade",
                responses_success: [
                    "These components carry the Light's resilience. They will serve you well.",
                    "Blessed parts, forged in the Ethereum's glow.",
                ],
                responses_fail: [
                ],
            ),
            (
                label: "I need no repair today",
                value: "leave",
                action: "close",
                responses_success: [
                    "The damage will worsen without the Light's touch.",
                    "Go in peace. Return when you are ready.",
                ],
                responses_fail: [
                ],
            ),
        ],
    )),
