    bullet_visual_overrides: None,
    metadata: (
        display_name: "Spirat Engineer",
        description_short: "A Spirat Engineer roaming the sector.",
        tags: ["npc", "mechanic", "spirat"],
        ui_color_hint: Some((0.9, 0.5, 0.1)),
    ),
    dialogue: Some((
        greetings: [
            "Your ship looks like it lost a fight with a pulsar. Lucky for you I have a wrench.",
            "Sal's Auto and Salvage. No warranties, no refunds, no questions about the parts.",
            "I can fix anything! For the right price. Where the parts come from is NOT your business.",
        ],
        farewells: [
            "It'll hold. Probably.",
            "Try not to break it before you leave atmo.",
            "You're welcome!",
        ],
        purposes: [
            (
                label: "Patch it up - 150 AETH",
                value: "mechanic_repair",
                action: "mechanic_repair",
                responses_success: [
                    "Patched up with salvage and prayers. Should hold.",
                    "Done. Don't ask what I used to seal that hull breach.",
                    "Fixed! The duct tape is structural. Trust me.",
                ],
                responses_fail: [
                    "No AETH, no fix. I don't work for exposure.",
                    "Come back when your pockets aren't empty.",
                ],
            ),
            (
                label: "Scavenge Parts",
                value: "trade",
                action: "open_trade",
                responses_success: [
                    "Cheap parts, acquired legitimately. Mostly.",
                    "I got salvage if you need it.",
                ],
                responses_fail: [
                ],
            ),
            (
                label: "No thanks",
                value: "leave",
                action: "close",
                responses_success: [
                    "Fine! Fly around leaking coolant. See if I care.",
                    "Your funeral.",
                ],
                responses_fail: [
                ],
            ),
        ],
    )),
)
