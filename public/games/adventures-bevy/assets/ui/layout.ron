// UI layout: iOS-calibrated (390×844). All gameplay HUD scaled from window; this is the design reference.
// Omitted keys use defaults in layout.rs.
(
    gameplay: (
        // Top: compact so game is visible
        wave_top: 6.0,
        wave_margin_h: -60.0,
        wave_padding_h: 6.0,
        wave_padding_v: 3.0,
        wave_font_size: 14.0,
        avatar_size: 36.0,
        avatar_left: 6.0,
        avatar_top: 6.0,
        bars_column_gap: 5.0,
        bars_row_gap: 3.0,
        bar_width: 78.0,
        bar_height: 10.0,
        bar_inner_gap: 3.0,
        username_font_size: 9.0,
        bar_label_font_size: 8.0,
        progression_row_gap: 2.0,
        progression_label_font_size: 7.0,
        progression_xp_width: 48.0,
        progression_xp_height: 5.0,
        pickup_status_gap: 3.0,
        pickup_status_font_size: 7.0,
        pickup_boost_center_top: 32.0,
        pickup_boost_center_icon_size: 12.0,
        pickup_boost_center_font_size: 12.0,
        pickup_boost_center_gap: 6.0,
        pickup_boost_center_margin_h: -80.0,
        minimap_size: 115.0,
        minimap_top: 6.0,
        minimap_right: 6.0,
        minimap_dot_size: 3.5,
        below_minimap: 96.0,
        right_panel_padding: 5.0,
        right_panel_gap: 3.0,
        // Joystick: larger for touch (1.5x scale)
        joystick_size: 240.0,
        joystick_inner: 192.0,
        joystick_knob_size: 78.0,
        joystick_bottom: 15.0,
        joystick_left: 15.0,
        joystick_toggle_font_size: 21.0,
        joystick_toggle_button_size: 78.0,
        joystick_dead_zone: 0.15,
        joystick_show_direction_indicator: true,
        // Action bar: bottom-right so FPS stays visible (FPS is top-right)
        action_bar_right: 6.0,
        action_bar_bottom: 6.0,
        energy_circle_size: 24.0,
        energy_bottom: 6.0,
        energy_padding: 6.0,
        energy_column_gap: 4.0,
        energy_ring_border: 2.0,
        boss_indicator_top: 76.0,
        boss_indicator_right: 6.0,
        boss_indicator_padding: 5.0,
        boss_indicator_column_gap: 3.0,
    ),
    hero_selection: (),
    action_bar: (
        btn_size: 96.0,
        border_radius: 12.0,
        gap: 4.0,
        hotkey_font_size: 16.0,
        inner_inset: 25.0,
    ),
    settings: (),
    designer: (),
    respawn: (),
)
