// Popup styling (loot, XP, damage, heal, level-up, etc.). See PickupsPopupsConfig. Hot-reload on native.
//
// XP / AETH / pickup lines: world-anchored floats; arc, gravity, jitter use damage_* keys below.
// Pickup types (pickup_collected): regen, power-up, stat boosts — position is pickup or player.
// Damage text: crit / normal / DoT / blocked; SDF gradients when sdf_font_path is set.
(
    white_wash: 0.12,

    // ========== AETH float (world position; motion = damage_*) ==========
    loot_duration: 2.0,
    loot_color: (1.0, 0.92, 0.35),
    loot_font_size: 26.0,

    // ========== XP float ==========
    xp_duration: 2.0,
    xp_color: (0.65, 0.45, 1.0),
    xp_font_size: 20.0,

    // ========== Pickup collected float (POWER UP! etc.) ==========
    pickup_collected_duration: 1.2,
    pickup_collected_font_size: 20.0,

    // ========== Level up (center banner, upper screen) ==========
    level_up_duration: 3.8,
    level_up_start_top: 118.0,
    level_up_drift_px_per_sec: 90.0,
    level_up_font_size: 28.0,
    level_up_color: (1.0, 0.9, 0.3),
    level_up_margin_left: -95.0,
    level_up_padding_v: 16.0,
    level_up_padding_h: 10.0,
    level_up_border_radius: 10.0,
    level_up_bg: (0.08, 0.06, 0.02, 0.68),

    // ========== Kill streak ==========
    kill_streak_duration: 2.5,
    kill_streak_start_top: 105.0,
    kill_streak_drift_px_per_sec: 60.0,
    kill_streak_font_size: 30.0,
    kill_streak_margin_left: -100.0,
    kill_streak_padding_v: 16.0,
    kill_streak_padding_h: 10.0,
    kill_streak_border_radius: 10.0,
    kill_streak_bg: (0.14, 0.04, 0.02, 0.92),

    // ========== Damage popups (floating numbers, Dodged!, Blocked!) ==========
    damage_duration: 0.45,
    damage_duration_crit: 0.65,
    damage_fade_out_secs: 0.48,
    damage_initial_velocity_up_px_per_sec: 120.0,
    damage_gravity_px_per_sec2: 320.0,
    damage_drift_x_px_per_sec: 24.0,
    damage_screen_offset_y: 2.5,
    damage_jitter_half_width_px: 40.0,
    damage_screen_offset_y_normal: Some(8.0),
    damage_screen_offset_y_dot: Some(0.0),
    damage_jitter_extra_non_normal: 24.0,
    damage_popup_max_per_frame: 4,
    damage_popup_pool_prewarm: 48,
    damage_popup_pool_cap: 128,
    damage_popup_blocked_player_only: true,
    damage_popup_blocked_cooldown_ms: 600,
    damage_popup_dodged_cooldown_ms: 200,
    damage_font_size_crit: 34.0,
    damage_font_size_normal: 17.0,
    damage_font_size_dodged_blocked: 19.0,
    damage_font_size_dot: 15.0,
    damage_color_crit: (1.0, 0.35, 0.15),
    damage_color_normal: (0.95, 0.97, 1.0),
    damage_color_slow: (0.45, 0.65, 1.0),
    damage_color_player_hit: (1.0, 0.4, 0.3),
    damage_color_dodged: (0.35, 0.85, 1.0),
    damage_color_blocked: (1.0, 0.45, 0.9),
    damage_color_dot: (1.0, 0.35, 0.55),
    damage_fill_crit: Some(( gradient: "vertical", start: (1.0, 0.15, 0.05, 1.0), end: (1.0, 0.55, 0.35, 1.0) )),
    damage_fill_normal: Some(( gradient: "vertical", start: (0.85, 0.9, 1.0, 1.0), end: (1.0, 1.0, 1.0, 1.0) )),
    damage_fill_slow: Some(( gradient: "vertical", start: (0.3, 0.5, 1.0, 1.0), end: (0.55, 0.75, 1.0, 1.0) )),
    damage_fill_player_hit: Some(( gradient: "vertical", start: (1.0, 0.25, 0.2, 1.0), end: (1.0, 0.5, 0.4, 1.0) )),
    damage_fill_dot: Some(( gradient: "vertical", start: (1.0, 0.2, 0.4, 1.0), end: (1.0, 0.45, 0.65, 1.0) )),

    // ========== Heal popups ==========
    heal_font_size: 13.0,
    heal_offset_right: 36.0,
    heal_hp_color: (0.2, 1.0, 0.45),
    heal_shield_color: (0.4, 0.75, 1.0),

    // ========== NPC Interaction Ranges ==========
    npc_shout_range: 40.0,
    npc_farewell_range: 30.0,
    npc_dock_range: 10.0,
)
