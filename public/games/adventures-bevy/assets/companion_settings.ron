(
    // Formation slots around the player (x, y, z)
    formation_offsets: [
        (4.0, 0.0, 4.0),
        (-4.0, 0.0, 4.0),
        (6.0, 0.0, 0.0),
        (-6.0, 0.0, 0.0),
        (4.0, 0.0, -4.0),
        (-4.0, 0.0, -4.0),
    ],

    // Follow behavior
    follow_stop_distance: 15.0,
    follow_speed_multiplier: 1.0,
    follow_accel_multiplier: 1.0,
    follow_rotation_multiplier: 1.0,

    // Attack behavior
    attack_speed_multiplier: 1.15,
    attack_accel_multiplier: 1.1,
    attack_stop_distance: 12.0,

    // Safety / tethering
    max_follow_distance: 0.0,
    teleport_distance: 80.0,
    use_player_rotation: true,

    // Companion drone stat variance (flock behaviour). use_random: true = roll each stat between min and max per spawn; false = use drone.ron values.
    drone_ranges: Some((
        use_random: true,
        health: (min: 320, max: 440),
        shield: (min: 320, max: 460),
        max_speed: (min: 20.0, max: 55.0),
        acceleration: (min: 0.5, max: 1.5),
        rotation_speed: (min: 5.0, max: 15.0),
        range: (min: 60.0, max: 120.0),
        cooldown: (min: 0.5, max: 1.5),
        bullet_speed: (min: 60.0, max: 120.0),
        damage: (min: 24, max: 48),
        scale: (min: 2.25, max: 2.75),
    )),
)
