// Galaxy map rendering config. Tune visuals without recompile.
(
    // Star rendering
    star_base_scale: 3.0,
    star_emissive_strength: 5.0,

    // Sector borders (Voronoi edges)
    border_color: (0.3, 0.8, 1.0, 0.6),
    border_width: 2.0,

    // Faction territory fill
    fill_alpha: 0.15,

    // Player beacon
    beacon_color: (1.0, 0.9, 0.2, 1.0),
    beacon_pulse_speed: 3.0,
    beacon_size: 8.0,

    // Galaxy-to-world coordinate scale
    // Maps the full galaxy (~50k parsec diameter) to Bevy world units
    galaxy_world_scale: 200000.0,
)
