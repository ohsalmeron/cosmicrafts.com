---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Cosmicrafts — space RTS strategy game by World of Unreal. Command fleets, build your economy, and battle in the Dark Rift.' } = Astro.props;
---

<!doctype html>
<html lang="en" class="min-h-screen w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#020208" />
    <!-- Simple performance preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Cosmic theme ported 1:1 from the Vue DAO frontend -->
    <link rel="stylesheet" href="/assets/css/cosmic-theme.css" />
    <link rel="stylesheet" href="/assets/css/universal.css" />
    <link rel="stylesheet" href="/assets/css/vue-hover.css" />
    <link rel="stylesheet" href="/assets/css/hero-section.css" />
  </head>
  <body class="min-h-screen w-full bg-[#05050f] text-white font-sans antialiased m-0 p-0 overflow-x-hidden">
    <slot />
    <script is:inline>
      // Minimal i18n runtime ported from the Vue DAO frontend (vue-i18n JSON dicts).
      // Elements opt in with data-i18n="path.to.key" (text) or data-i18n-ph="path" (placeholder).
      window.CC = window.CC || {};
      CC.lang = (() => { try { return localStorage.getItem('cc-lang') || 'en'; } catch { return 'en'; } })();
      CC.dict = {}; CC.fallback = {};
      CC.t = (path) => {
        const get = (o) => String(path).split('.').reduce((a, k) => {
          if (a === undefined || a === null) return undefined;
          const m = k.match(/^([A-Za-z0-9_-]+)\[(\d+)\]$/);
          if (m) { const arr = a[m[1]]; return Array.isArray(arr) ? arr[Number(m[2])] : undefined; }
          return a[k];
        }, o);
        const v = get(CC.dict); if (v !== undefined) return v;
        const f = get(CC.fallback); if (f !== undefined) return f;
        return path;
      };
      CC.applyI18n = (root) => {
        (root || document).querySelectorAll('[data-i18n]').forEach((el) => { el.textContent = CC.t(el.getAttribute('data-i18n')); });
        (root || document).querySelectorAll('[data-i18n-ph]').forEach((el) => { el.setAttribute('placeholder', CC.t(el.getAttribute('data-i18n-ph'))); });
      };
      CC.setLang = async (lang) => {
        CC.lang = lang;
        try { localStorage.setItem('cc-lang', lang); } catch {}
        try {
          const r = await fetch('/i18n/' + lang + '.json');
          if (r.ok) CC.dict = await r.json();
        } catch {}
        document.documentElement.lang = lang;
        CC.applyI18n(document);
        document.dispatchEvent(new CustomEvent('cc:lang', { detail: { lang } }));
      };
      (async () => {
        try {
          const [fb, cur] = await Promise.all([
            fetch('/i18n/en.json').then((r) => (r.ok ? r.json() : {})),
            CC.lang === 'en' ? Promise.resolve(null) : fetch('/i18n/' + CC.lang + '.json').then((r) => (r.ok ? r.json() : null)).catch(() => null),
          ]);
          CC.fallback = fb || {}; CC.dict = cur || fb || {};
        } catch {}
        document.documentElement.lang = CC.lang;
        CC.applyI18n(document);
        document.dispatchEvent(new CustomEvent('cc:lang', { detail: { lang: CC.lang } }));
      })();
    </script>
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  :root {
    --font-sans: 'Plus Jakarta Sans', sans-serif;
    color-scheme: dark;
  }
  html {
    -webkit-tap-highlight-color: rgba(6, 182, 212, 0.25);
  }
  a, button {
    touch-action: manipulation;
  }
  :focus-visible {
    outline: 2px solid rgba(34, 211, 238, 0.8);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
  body {
    font-family: var(--font-sans);
  }

  /* ponytail: global scrollbar style to eliminate duplicate local declarations */
  .scrollbar-thin::-webkit-scrollbar {
    width: 4px;
    height: 4px;
  }
  .scrollbar-thin::-webkit-scrollbar-track {
    background: transparent;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb:hover {
    background: rgba(6, 182, 212, 0.4);
  }
</style>
