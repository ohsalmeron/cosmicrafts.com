---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Cosmicrafts — space RTS strategy game by World of Unreal. Command fleets, build your economy, and battle in the Dark Rift.' } = Astro.props;
---

<!doctype html>
<html lang="en" class="min-h-screen w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#020208" />
    <!-- Simple performance preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen w-full bg-[#05050f] text-white font-sans antialiased m-0 p-0 overflow-x-hidden">
    <slot />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  :root {
    --font-sans: 'Plus Jakarta Sans', sans-serif;
    color-scheme: dark;
  }
  html {
    -webkit-tap-highlight-color: rgba(6, 182, 212, 0.25);
  }
  a, button {
    touch-action: manipulation;
  }
  :focus-visible {
    outline: 2px solid rgba(34, 211, 238, 0.8);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
  body {
    font-family: var(--font-sans);
  }

  /* ponytail: global scrollbar style to eliminate duplicate local declarations */
  .scrollbar-thin::-webkit-scrollbar {
    width: 4px;
    height: 4px;
  }
  .scrollbar-thin::-webkit-scrollbar-track {
    background: transparent;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb:hover {
    background: rgba(6, 182, 212, 0.4);
  }
</style>
