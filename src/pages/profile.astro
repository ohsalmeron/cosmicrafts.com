---
import Layout from '../layouts/Layout.astro';
import Starfield from '../components/Starfield.astro';
import Header from '../components/Header.astro';
import Panel from '../components/Panel.astro';
---

<Layout title="Cosmicrafts | Commander Profile">
  <!-- Viewport-Locked Container -->
  <div class="fixed inset-0 h-screen w-screen overflow-hidden flex flex-col justify-between p-4 sm:p-6 md:p-10 select-none z-10 bg-[#020208]">
    <!-- Starfield Background -->
    <Starfield />

    <!-- Ambient glows -->
    <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-cyan-500/5 rounded-full blur-[140px] pointer-events-none z-0"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-indigo-500/5 rounded-full blur-[140px] pointer-events-none z-0"></div>

    <!-- Header component -->
    <Header />

    <!-- Main Profile Card Content Area -->
    <main class="w-full max-w-7xl mx-auto flex-1 flex flex-col my-3 sm:my-4 overflow-hidden z-10 justify-center">

      <!-- Loading State -->
      <div id="profile-loading" class="flex flex-col items-center justify-center py-20 space-y-4 font-mono">
        <div class="w-10 h-10 border-2 border-cyan-500/20 border-t-cyan-400 rounded-full animate-spin"></div>
        <p class="text-xs text-slate-400 uppercase tracking-widest">[ DECRYPTING TELEMETRY PROFILE... ]</p>
      </div>

      <!-- Guest / Logged Out State -->
      <div id="profile-guest" class="hidden text-center py-16 px-6 bg-slate-950/70 border border-white/10 rounded-2xl backdrop-blur-xl max-w-lg mx-auto space-y-5">
        <div class="w-16 h-16 rounded-full bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 mx-auto text-2xl">
          🚀
        </div>
        <div class="space-y-1">
          <h2 class="text-xl font-bold uppercase tracking-tight text-white">Commander Not Connected</h2>
          <p class="text-xs text-slate-400 font-mono font-light">
            Connect via World of Unreal Identity to inspect your cross-chain profile, fleet inventory, and battle rank.
          </p>
        </div>
        <button id="guest-connect-btn" type="button" class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-indigo-500 hover:from-cyan-400 hover:to-indigo-400 text-white font-mono text-xs font-bold uppercase tracking-widest shadow-lg shadow-cyan-500/25 transition cursor-pointer">
          Establish Connection
        </button>
      </div>

      <!-- Main Authenticated Steam Card Frame -->
      <div id="profile-content" class="hidden w-full">
        <Panel id="profile-frame" class="w-full max-w-5xl mx-auto p-5 sm:p-6 md:p-8 flex flex-col md:flex-row gap-6 md:gap-8 items-stretch">

          <!-- Left side: Player Basic Info -->
          <div class="w-full md:w-80 flex flex-col justify-between border-b md:border-b-0 md:border-r border-white/5 pb-6 md:pb-0 md:pr-8">
            <div class="space-y-5">
              <!-- Avatar & Username block -->
              <div class="flex items-center space-x-4">
                <!-- Avatar Circle -->
                <div class="relative w-16 h-16 rounded-2xl border-2 border-cyan-500/40 overflow-hidden shadow-[0_0_20px_rgba(6,182,212,0.2)] flex-shrink-0 bg-slate-900 flex items-center justify-center">
                  <img id="player-avatar" src="" alt="Avatar" class="hidden w-full h-full object-cover" />
                  <span id="player-avatar-emoji" class="text-2xl">🎮</span>
                </div>
                <div class="flex flex-col text-left min-w-0">
                  <div class="flex items-center gap-1.5">
                    <h2 id="player-name" class="text-base sm:text-xl font-black text-white uppercase tracking-tight truncate">COMMANDER</h2>
                    <span id="player-clan" class="hidden px-2 py-0.5 rounded bg-purple-500/20 text-purple-300 font-mono text-[9px] font-bold">[TAG]</span>
                  </div>
                  <span id="player-handle" class="text-[11px] text-cyan-400 font-mono tracking-wider">@commander</span>
                  <span id="player-title" class="text-[9px] text-slate-400 font-mono tracking-widest uppercase mt-0.5">Galactic Fleet Officer</span>
                </div>
              </div>

              <!-- Level Progression -->
              <div class="space-y-1.5 font-mono text-[10px] text-left">
                <div class="flex justify-between text-slate-400 uppercase">
                  <span>Fleet Rank: <span id="player-level" class="text-white font-bold">Level 1</span></span>
                  <span>XP: <span id="player-xp-val" class="text-cyan-400">100%</span></span>
                </div>
                <div class="w-full h-2 bg-slate-900 border border-white/5 rounded-full overflow-hidden">
                  <div id="player-xp-bar" class="h-full bg-gradient-to-r from-cyan-500 to-indigo-500 rounded-full" style="width: 100%"></div>
                </div>
              </div>

              <!-- Vault & Public Cryptographic Identities -->
              <div class="bg-white/5 border border-white/5 rounded-xl p-3.5 font-mono text-[10px] text-left space-y-2">
                <div class="text-[9px] text-slate-500 tracking-wider uppercase border-b border-white/5 pb-1 flex justify-between">
                  <span>[ PUBLIC GAMING VAULT ]</span>
                  <span class="text-emerald-400 font-bold">VERIFIED</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-slate-400">EVM:</span>
                  <span id="vault-evm" class="text-white select-text font-bold truncate max-w-[140px]">0x0...000</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-slate-400">SOL:</span>
                  <span id="vault-sol" class="text-purple-300 select-text font-bold truncate max-w-[140px]">Sol...000</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-slate-400">ICP:</span>
                  <span id="vault-icp" class="text-cyan-300 select-text font-bold truncate max-w-[140px]">icp...000</span>
                </div>
              </div>
            </div>

            <!-- Bio / Dispatch Note -->
            <div class="pt-4 border-t border-white/5 mt-4 text-left font-mono text-[10px] text-slate-400">
              <span class="text-[9px] text-slate-500 block mb-1 uppercase">[ DISPATCH BIO ]</span>
              <p id="player-bio" class="text-slate-300 leading-relaxed font-sans text-xs">
                Active Cosmicrafts Commander.
              </p>
            </div>
          </div>

          <!-- Right side: Achievements and Inventory -->
          <div class="flex-1 flex flex-col gap-5 overflow-y-auto max-h-[50vh] md:max-h-[480px] scrollbar-thin text-left pr-1">
            <!-- Cross-Game Battle Stats -->
            <div class="space-y-2.5">
              <h3 class="text-[11px] text-cyan-400 font-mono tracking-widest uppercase border-b border-white/5 pb-1.5 flex items-center justify-between">
                <span>[ COMBAT TELEMETRY & STATS ]</span>
                <span class="text-slate-500 text-[9px]">CROSS-GAME ECOSYSTEM</span>
              </h3>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 font-mono text-[10px]">
                <div class="p-2.5 rounded-lg bg-slate-950/60 border border-white/5">
                  <span class="text-slate-500 block text-[8px]">SOW RANK</span>
                  <span id="stat-sow-rank" class="text-white font-bold">Recruit</span>
                </div>
                <div class="p-2.5 rounded-lg bg-slate-950/60 border border-white/5">
                  <span class="text-slate-500 block text-[8px]">SOW ELO</span>
                  <span id="stat-sow-elo" class="text-cyan-400 font-bold">1200</span>
                </div>
                <div class="p-2.5 rounded-lg bg-slate-950/60 border border-white/5">
                  <span class="text-slate-500 block text-[8px]">FLEET POWER</span>
                  <span id="stat-fleet-power" class="text-amber-400 font-bold">1,500</span>
                </div>
                <div class="p-2.5 rounded-lg bg-slate-950/60 border border-white/5">
                  <span class="text-slate-500 block text-[8px]">NFTROPOLY WORTH</span>
                  <span id="stat-nft-worth" class="text-purple-400 font-bold">$0</span>
                </div>
              </div>
            </div>

            <!-- Inventory Section -->
            <div class="space-y-2.5">
              <h3 class="text-[11px] text-cyan-400 font-mono tracking-widest uppercase border-b border-white/5 pb-1.5 flex items-center justify-between">
                <span>[ AUTHORITATIVE FLEET INVENTORY ]</span>
                <span class="text-slate-500 text-[9px]">7 ITEMS</span>
              </h3>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 max-h-[260px] overflow-y-auto pr-1 scrollbar-thin" id="inventory-container">
                <!-- Populated via script -->
              </div>
            </div>
          </div>
        </Panel>
      </div>
    </main>

    <!-- Floating High-Detail NFT Visor / Modal -->
    <div id="nft-visor-modal" class="fixed inset-0 z-[9999] hidden items-center justify-center p-4 bg-slate-950/50 backdrop-blur-md">
      <!-- Backdrop Click Close -->
      <div class="absolute inset-0 z-0" id="nft-visor-backdrop"></div>
      
      <!-- Visor Content Panel -->
      <Panel class="relative w-full max-w-3xl p-6 md:p-8 flex flex-col md:flex-row gap-6 md:gap-10 z-10 select-none text-left">

        <!-- Left Column: Visual Render -->
        <div class="w-full md:w-72 flex flex-col items-center justify-center bg-[radial-gradient(circle_at_center,rgba(6,182,212,0.12)_0%,transparent_75%)] border border-white/5 rounded-xl p-6 relative">
          <!-- Rarity Badge -->
          <span id="visor-rarity" class="absolute top-3 left-3 px-2 py-0.5 rounded text-[8px] font-mono font-black uppercase tracking-widest bg-slate-950 border border-white/5">
            LEGENDARY
          </span>
          <img id="visor-img" src="/assets/starter-ship.webp" alt="Visor Render" class="max-w-[85%] max-h-56 object-contain drop-shadow-[0_10px_35px_rgba(15,185,253,0.3)] animate-float" />
        </div>

        <!-- Right Column: Technical Specifications -->
        <div class="flex-1 flex flex-col justify-between overflow-y-auto max-h-[60vh] md:max-h-[350px] scrollbar-thin font-mono text-[10px] text-slate-400 space-y-4">
          <div>
            <div class="flex items-center justify-between border-b border-white/5 pb-2 mb-3">
              <span class="text-cyan-400 text-xs font-black uppercase">[ TELEMETRY DETAILED READOUT ]</span>
              <button id="btn-close-visor" type="button" class="text-[10px] hover:text-white transition-colors cursor-pointer">CLOSE ✕</button>
            </div>

            <!-- Title & ID -->
            <div class="space-y-1 mb-4">
              <h1 id="visor-name" class="text-xl font-black text-white uppercase tracking-tight leading-none">Void Dreadnought</h1>
              <span id="visor-serial" class="text-slate-500 text-xs">ID: #0001</span>
            </div>

            <!-- Spec Grid -->
            <div class="grid grid-cols-2 gap-x-6 gap-y-2 bg-white/5 border border-white/5 rounded-lg p-3 mb-4">
              <div class="flex justify-between border-b border-white/5 pb-1">
                <span class="text-slate-500">FIREPOWER:</span>
                <span id="visor-power" class="text-white font-bold">98%</span>
              </div>
              <div class="flex justify-between border-b border-white/5 pb-1">
                <span class="text-slate-500">SPEED_INDEX:</span>
                <span id="visor-speed" class="text-white font-bold">9.5LY</span>
              </div>
              <div class="flex justify-between border-b border-white/5 pb-1">
                <span class="text-slate-500">HULL PLATING:</span>
                <span class="text-cyan-400">NANO-CARBON</span>
              </div>
              <div class="flex justify-between border-b border-white/5 pb-1">
                <span class="text-slate-500">SHIELD TYPE:</span>
                <span class="text-cyan-400">AEGIS MK-V</span>
              </div>
              <div class="flex justify-between col-span-2 pt-1">
                <span class="text-slate-500">EST_VALUATION:</span>
                <span id="visor-val" class="text-cyan-400 font-black">150,000 SPIRAL</span>
              </div>
            </div>

            <!-- Web3 Ledger data -->
            <div class="space-y-1.5 border-t border-white/5 pt-3">
              <span class="text-[8px] text-slate-500 uppercase font-black tracking-widest">[ BLOCKCHAIN LEDGER DATA ]</span>
              <div class="flex justify-between">
                <span>CONTRACT STANDARD:</span>
                <span class="text-slate-300">ERC-1155 (COSMIC_STORE)</span>
              </div>
              <div class="flex justify-between">
                <span>METADATA STORAGE:</span>
                <span class="text-slate-300">DECENTRALIZED IPFS</span>
              </div>
              <div class="flex justify-between">
                <span>VERIFICATION:</span>
                <span class="text-emerald-400">WOU-ID PROTOCOL VERIFIED</span>
              </div>
            </div>
          </div>
        </div>
      </Panel>
    </div>
  </div>
</Layout>

<script>
  import { wouAuth, type WouAccount } from '../scripts/wou-auth';

  const loadingEl = document.getElementById('profile-loading');
  const guestEl = document.getElementById('profile-guest');
  const contentEl = document.getElementById('profile-content');
  const guestConnectBtn = document.getElementById('guest-connect-btn');

  // Profile Elements
  const playerName = document.getElementById('player-name');
  const playerClan = document.getElementById('player-clan');
  const playerHandle = document.getElementById('player-handle');
  const playerBio = document.getElementById('player-bio');
  const playerAvatar = document.getElementById('player-avatar') as HTMLImageElement;
  const playerAvatarEmoji = document.getElementById('player-avatar-emoji');

  const vaultEvm = document.getElementById('vault-evm');
  const vaultSol = document.getElementById('vault-sol');
  const vaultIcp = document.getElementById('vault-icp');

  const statSowRank = document.getElementById('stat-sow-rank');
  const statSowElo = document.getElementById('stat-sow-elo');
  const statFleetPower = document.getElementById('stat-fleet-power');
  const statNftWorth = document.getElementById('stat-nft-worth');

  const invContainer = document.getElementById('inventory-container');

  // Modal Visor elements
  const nftVisorModal = document.getElementById('nft-visor-modal');
  const nftVisorBackdrop = document.getElementById('nft-visor-backdrop');
  const btnCloseVisor = document.getElementById('btn-close-visor');
  const visorImg = document.getElementById('visor-img') as HTMLImageElement;
  const visorName = document.getElementById('visor-name');
  const visorSerial = document.getElementById('visor-serial');
  const visorRarity = document.getElementById('visor-rarity');
  const visorPower = document.getElementById('visor-power');
  const visorSpeed = document.getElementById('visor-speed');
  const visorVal = document.getElementById('visor-val');

  const fleetInventory = [
    { name: "Void Dreadnought", serial: "0001", rarity: "Mythic", power: 98, speed: "9.5", value: "150,000", img: "/assets/starter-ship.webp" },
    { name: "Solaris Cruiser", serial: "0042", rarity: "Legendary", power: 88, speed: "8.2", value: "85,000", img: "/assets/starter-ship.webp" },
    { name: "Quantum Interceptor", serial: "0109", rarity: "Epic", power: 74, speed: "11.0", value: "42,000", img: "/assets/starter-ship.webp" },
    { name: "Nebula Frigate", serial: "0314", rarity: "Rare", power: 65, speed: "7.8", value: "18,500", img: "/assets/starter-ship.webp" },
    { name: "Aegis Recon Scout", serial: "0892", rarity: "Rare", power: 52, speed: "12.4", value: "12,000", img: "/assets/starter-ship.webp" },
    { name: "Titan Harvester", serial: "1024", rarity: "Epic", power: 80, speed: "5.5", value: "35,000", img: "/assets/starter-ship.webp" },
    { name: "Plasma Striker", serial: "2048", rarity: "Rare", power: 60, speed: "9.8", value: "15,000", img: "/assets/starter-ship.webp" },
  ];

  function openVisor(item: any) {
    if (visorImg) visorImg.src = item.img;
    if (visorName) visorName.innerText = item.name;
    if (visorSerial) visorSerial.innerText = `ID: #${item.serial}`;
    if (visorRarity) visorRarity.innerText = item.rarity;
    if (visorPower) visorPower.innerText = `${item.power}%`;
    if (visorSpeed) visorSpeed.innerText = `${item.speed}LY`;
    if (visorVal) visorVal.innerText = `${item.value} SPIRAL`;

    nftVisorModal?.classList.remove('hidden');
    nftVisorModal?.classList.add('flex');
  }

  function closeVisor() {
    nftVisorModal?.classList.add('hidden');
    nftVisorModal?.classList.remove('flex');
  }

  btnCloseVisor?.addEventListener('click', closeVisor);
  nftVisorBackdrop?.addEventListener('click', closeVisor);

  function renderProfile(user: WouAccount) {
    loadingEl?.classList.add('hidden');
    guestEl?.classList.add('hidden');
    contentEl?.classList.remove('hidden');

    if (playerName) playerName.textContent = user.display_name || user.username || 'Commander';
    if (playerHandle) playerHandle.textContent = user.username ? `@${user.username}` : '@commander';
    if (playerBio) playerBio.textContent = user.profile?.bio || 'Active Cosmicrafts Commander.';

    if (user.clan_tag && playerClan) {
      playerClan.textContent = `[${user.clan_tag.toUpperCase()}]`;
      playerClan.classList.remove('hidden');
    } else if (playerClan) {
      playerClan.classList.add('hidden');
    }

    if (user.profile?.avatar_url && playerAvatar) {
      playerAvatar.src = user.profile.avatar_url;
      playerAvatar.classList.remove('hidden');
      playerAvatarEmoji?.classList.add('hidden');
    } else if (playerAvatarEmoji) {
      const emoji = (user.profile as any)?.custom_attributes?.animal_emoji || '🎮';
      playerAvatarEmoji.textContent = emoji;
      playerAvatarEmoji.classList.remove('hidden');
      playerAvatar?.classList.add('hidden');
    }

    // Wallets
    if (user.embedded_wallets) {
      if (vaultEvm) {
        const a = user.embedded_wallets.evm_address;
        vaultEvm.textContent = a ? `${a.slice(0, 6)}...${a.slice(-4)}` : 'N/A';
      }
      if (vaultSol) {
        const a = user.embedded_wallets.solana_address;
        vaultSol.textContent = a ? `${a.slice(0, 4)}...${a.slice(-4)}` : 'N/A';
      }
      if (vaultIcp) {
        const a = user.embedded_wallets.icp_principal;
        vaultIcp.textContent = a ? `${a.slice(0, 5)}...${a.slice(-3)}` : 'N/A';
      }
    }

    // Stats
    if (user.game_stats) {
      if (statSowRank) statSowRank.textContent = user.game_stats.sow_rank || 'Recruit';
      if (statSowElo) statSowElo.textContent = String(user.game_stats.sow_elo || 1200);
      if (statFleetPower) statFleetPower.textContent = `${user.game_stats.cosmicrafts_fleet_power || 1500} FP`;
      if (statNftWorth) statNftWorth.textContent = `$${user.game_stats.nftropoly_net_worth || 0}`;
    }

    // Render Fleet Inventory Cards
    if (invContainer) {
      invContainer.innerHTML = '';
      fleetInventory.forEach((inv) => {
        let borderGlow = "border-cyan-500/20 hover:border-cyan-400/40 bg-cyan-950/10";
        let textGlow = "text-cyan-400";
        if (inv.rarity === "Mythic") {
          borderGlow = "border-purple-500/20 hover:border-purple-400/50 bg-purple-950/10";
          textGlow = "text-purple-400";
        } else if (inv.rarity === "Legendary") {
          borderGlow = "border-amber-500/20 hover:border-amber-400/50 bg-amber-950/10";
          textGlow = "text-amber-400";
        }

        const card = document.createElement('div');
        card.className = `bg-slate-950/60 border p-2.5 rounded-xl flex flex-col items-center text-center cursor-pointer transition-all duration-200 ${borderGlow} group`;
        card.innerHTML = `
          <div class="relative w-full aspect-square bg-[radial-gradient(circle_at_center,rgba(6,182,212,0.08)_0%,transparent_70%)] border-b border-white/5 flex items-center justify-center p-2 rounded-t-lg">
            <span class="absolute top-1 left-1 px-1.5 py-0.5 rounded text-[6px] font-mono font-black uppercase tracking-widest bg-slate-950/90 border border-white/5 ${textGlow}">
              ${inv.rarity}
            </span>
            <img src="${inv.img}" alt="${inv.name}" class="max-w-[75%] max-h-[75%] object-contain drop-shadow-[0_4px_10px_rgba(0,0,0,0.5)] group-hover:scale-105 transition-transform" />
          </div>
          <div class="p-1.5 w-full flex flex-col text-left space-y-1 font-mono">
            <span class="text-[9px] text-white font-bold uppercase truncate">${inv.name}</span>
            <div class="flex justify-between items-center text-[7px] text-slate-400">
              <span>PWR: ${inv.power}%</span>
              <span>SPD: ${inv.speed}LY</span>
            </div>
            <div class="flex items-center justify-between border-t border-white/5 pt-1 mt-0.5">
              <span class="text-[6px] text-slate-500 uppercase">VALUE:</span>
              <span class="text-[8px] text-cyan-400 font-bold">${inv.value} SP</span>
            </div>
          </div>
        `;
        card.addEventListener('click', () => openVisor(inv));
        invContainer.appendChild(card);
      });
    }
  }

  guestConnectBtn?.addEventListener('click', () => {
    wouAuth.openModal();
  });

  // Initial check
  const currentUser = wouAuth.getUser();
  if (currentUser) {
    renderProfile(currentUser);
  } else {
    setTimeout(() => {
      if (!wouAuth.isAuthenticated()) {
        loadingEl?.classList.add('hidden');
        guestEl?.classList.remove('hidden');
        contentEl?.classList.add('hidden');
      } else {
        renderProfile(wouAuth.getUser()!);
      }
    }, 300);
  }

  window.addEventListener('wou:auth-state-change', (e: any) => {
    if (e.detail?.isAuthenticated && e.detail?.user) {
      renderProfile(e.detail.user);
    } else {
      loadingEl?.classList.add('hidden');
      guestEl?.classList.remove('hidden');
      contentEl?.classList.add('hidden');
    }
  });
</script>

<style>
  @keyframes float-visor {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-8px) rotate(1.5deg); }
  }
  .animate-float {
    animation: float-visor 6s ease-in-out infinite;
  }
</style>
