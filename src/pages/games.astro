---
import Layout from '../layouts/Layout.astro';
import Starfield from '../components/Starfield.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { GAMES, BATTLEGROUNDS } from '../data/games';

/**
 * Games library — 1:1 behavior port of the Vue DAO Games.vue:
 * Battlegrounds banner, game cards, and the launcher modal.
 */
const cards = GAMES.map((g) => ({
  id: g.id,
  title: `${g.name} (${g.year})`,
  image: g.image,
  description: g.description,
  badge: g.badge,
  badgeClass: g.badgeClass,
  release: g.release,
  genre: g.genre,
  features: g.features,
  route: g.status === 'soon' ? '' : (g.playRoute || g.externalUrl || ''),
  cta: g.status === 'soon' ? g.statusLabel : `Play ${g.name}`,
}));
---
<link rel="stylesheet" href="/assets/css/games-vue.css" />

<Layout title="Cosmicrafts | Games" description="Play the Cosmicrafts game library: Star Drifter, Adventures Bevy, Rush, Adventures 3D, 2D classic, Alpha and Beta.">
  <div class="relative min-h-screen w-full flex flex-col z-10">
    <div class="fixed inset-0 z-0 pointer-events-none" aria-hidden="true">
      <Starfield />
    </div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 md:px-6">
      <Header />
    </div>

    <main class="games-container relative z-10">
      <section class="battlegrounds-banner cosmic-panel cosmic-float">
        <img class="banner-bg-image" src="/assets/webp/banner-battlegrounds.webp" alt="" aria-hidden="true" loading="lazy" />
        <div class="banner-content">
          <img class="banner-logo" src="/assets/webp/battlegrounds.webp" alt="Cosmicrafts Battlegrounds Logo" loading="lazy" />
          <div class="banner-text">
            <h1 class="banner-title text-gradient" data-i18n="games.battlegrounds.title">Cosmicrafts Battlegrounds</h1>
            <p class="banner-subtitle text-secondary">Launching Q4 2025 — The next evolution in on-chain RTS. Wishlist and play the demo now!</p>
            <div class="banner-ctas">
              <a class="cosmic-button cosmic-button-primary min-h-[44px]" href={BATTLEGROUNDS.epicUrl} target="_blank" rel="noopener">
                <span class="button-text">Wishlist on Epic Games</span>
                <span class="button-glow"></span>
                <span class="button-particles"></span>
              </a>
              <a class="cosmic-button cosmic-button-secondary min-h-[44px]" href={BATTLEGROUNDS.itchUrl} target="_blank" rel="noopener">
                <span class="button-text">Play Demo on itch.io</span>
                <span class="button-glow"></span>
                <span class="button-particles"></span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="games-grid" id="games-grid">
        {cards.map((c) => (
          <article class="game-card" data-game={c.id} tabindex={c.route ? '0' : undefined} role={c.route ? 'button' : undefined} aria-disabled={c.route ? undefined : 'true'}>
            <div class="game-image">
              <div class={`game-badge ${c.badgeClass}`}>{c.badge}</div>
              <img src={c.image} alt={c.title} loading="lazy" />
            </div>
            <div class="game-info">
              <h3 class="game-title">{c.title}</h3>
              <p class="game-description">{c.description}</p>
              <div class="game-meta">
                <span class="release-date">{c.release}</span>
                <span class="game-type">{c.genre}</span>
              </div>
              <div class="game-features">
                {c.features.map((f) => <span class="feature">{f}</span>)}
              </div>
            </div>
            <div class="game-cta">
              <span class="play-button">{c.cta}</span>
            </div>
          </article>
        ))}
      </section>

      <div id="game-launcher" class="game-launcher-modal" hidden>
        <div class="launcher-content" role="dialog" aria-modal="true" aria-labelledby="launcher-title">
          <div class="launcher-header">
            <h2 id="launcher-title">Launching</h2>
            <button class="close-button min-h-[44px] min-w-[44px]" id="launcher-close" aria-label="Close">×</button>
          </div>
          <div class="launcher-body">
            <div class="game-preview">
              <img id="launcher-img" src="" alt="" />
            </div>
            <div class="launch-options">
              <div class="option-group">
                <h4>Launch Options</h4>
                <div class="option">
                  <input type="radio" id="launch-web" name="launchType" value="web" checked />
                  <label for="launch-web">Web Browser (Recommended)</label>
                </div>
              </div>
              <div class="launch-button-container">
                <button class="launch-button min-h-[44px]" id="launcher-go">Launch</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <div class="relative z-10">
      <Footer />
    </div>
  </div>
</Layout>

<script define:vars={{ cards }}>
  const modal = document.getElementById('game-launcher');
  const title = document.getElementById('launcher-title');
  const img = document.getElementById('launcher-img');
  const go = document.getElementById('launcher-go');
  let route = '';
  const open = (c) => {
    if (!c.route) return;
    route = c.route;
    title.textContent = 'Launching ' + c.title;
    img.src = c.image; img.alt = c.title;
    go.textContent = 'Launch ' + c.title;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  };
  const close = () => { modal.hidden = true; document.body.style.overflow = ''; };
  document.querySelectorAll('#games-grid .game-card[data-game]').forEach((el) => {
    const c = cards.find((x) => x.id === el.getAttribute('data-game'));
    if (!c || !c.route) return;
    el.addEventListener('click', () => open(c));
    el.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(c); } });
  });
  document.getElementById('launcher-close')?.addEventListener('click', close);
  modal?.addEventListener('click', (e) => { if (e.target === modal) close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) close(); });
  go?.addEventListener('click', () => { if (route) window.location.href = route; close(); });
</script>

<style>
  .game-badge.live { background: linear-gradient(135deg, #00e5ff, #2979ff); color: white; }
  .game-badge.new { background: linear-gradient(135deg, #00e676, #00b0ff); color: white; }
  .game-launcher-modal[hidden] { display: none; }
  .game-card { text-decoration: none; }
  .game-card[aria-disabled="true"] { cursor: default; }
</style>
