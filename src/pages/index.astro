---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import Lore from '../components/Lore.astro';
import Lore2 from '../components/Lore2.astro';
import GamesSection from '../components/GamesSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Cosmicrafts | Space RTS Strategy Game" description="Cosmicrafts is a space RTS strategy game by World of Unreal. Command fleets, build your economy, and battle in the Dark Rift. Read the whitepaper, explore the games.">
  <div class="relative min-h-screen w-full flex flex-col z-10 bg-[#020208]">
    <div class="relative z-20 w-full max-w-7xl mx-auto px-4 md:px-6">
      <Header overlay />
    </div>

    <main class="w-full flex-1 z-10">
      <HeroCarousel />
      <Lore />
      <GamesSection />
      <Lore2 />
    </main>

    <div class="relative z-10">
      <Footer />
    </div>
  </div>
</Layout>

<style>
  :global(html), :global(body) {
    min-height: 100%;
  }
</style>
