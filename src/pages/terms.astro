---
import Layout from '../layouts/Layout.astro';
import PageBackdrop from '../components/PageBackdrop.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Terms | Cosmicrafts" description="Cosmicrafts terms of service. Rules of the Dark Rift.">
  <div class="relative min-h-screen w-full flex flex-col z-10">
    <PageBackdrop />
    <div class="relative z-20 w-full px-4 md:px-6">
      <Header overlay />
    </div>
  <main class="relative z-10 max-w-3xl mx-auto px-6 pt-28 pb-24 text-slate-300 text-sm leading-relaxed">
    <p class="text-[11px] font-mono text-cyan-400 tracking-widest">LEGAL</p>
    <h1 class="text-4xl font-black text-white uppercase tracking-tight mt-2 mb-4">Terms</h1>
    <p>
      Using Cosmicrafts means accepting the canonical terms at
      <a class="underline" href="https://worldofunreal.com/terms">worldofunreal.com/terms</a>.
      13 and older; 13–17 with a parent/guardian's permission.
    </p>
    <p class="mt-4">
      Fleets, ranks, and SPIRAL gameplay assets have no monetary value and may change for balance,
      operation, or legal reasons. Token risk disclosures: <a class="underline" href="/docs/legal">Legal &amp; Disclaimers</a>.
    </p>
  </main>
    <div class="relative z-10 mt-auto">
      <Footer />
    </div>
  </div>
</Layout>
