---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms | Cosmicrafts">
  <main class="max-w-3xl mx-auto px-6 py-24 text-slate-300 text-sm leading-relaxed">
    <p class="text-[11px] font-mono text-cyan-400 tracking-widest">LEGAL</p>
    <h1 class="text-4xl font-black text-white uppercase tracking-tight mt-2 mb-4">Terms</h1>
    <p>
      Using Cosmicrafts means accepting the canonical terms at
      <a class="underline" href="https://worldofunreal.com/terms">worldofunreal.com/terms</a>.
      13 and older; 13–17 with a parent/guardian's permission.
    </p>
    <p class="mt-4">
      Fleets, ranks, and SPIRAL gameplay assets have no monetary value and may change for balance,
      operation, or legal reasons. Token risk disclosures: <a class="underline" href="/docs/legal">Legal &amp; Disclaimers</a>.
    </p>
  </main>
</Layout>
