---
import Panel from './Panel.astro';
import type { Game } from '../data/games';

interface Props {
  game: Game;
  index: number;
}

const { game, index } = Astro.props;

const tagStyles: Record<string, string> = {
  emerald: 'bg-emerald-500/15 border-emerald-500/30 text-emerald-300',
  cyan: 'bg-cyan-500/15 border-cyan-500/30 text-cyan-300',
  purple: 'bg-purple-500/15 border-purple-500/30 text-purple-300',
  rose: 'bg-rose-500/15 border-rose-500/30 text-rose-300',
  amber: 'bg-amber-500/15 border-amber-500/30 text-amber-300',
};

const href = game.externalUrl ?? game.playRoute ?? game.repo;
const external = Boolean(game.externalUrl);
---

<Panel variant={index % 2 === 0 ? 'cyan' : 'purple'} class="overflow-hidden group hover:border-cyan-400/30 transition-all duration-300 hover:-translate-y-1 flex flex-col">
  <div class="relative h-44 overflow-hidden -m-0">
    <img src={game.image} alt={game.name} loading="lazy" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
    <span class={`absolute top-3 right-3 px-2 py-0.5 rounded-full border text-[9px] font-mono font-bold tracking-widest uppercase ${tagStyles[game.tagColor]}`}>
      {game.tag}
    </span>
    <span class="absolute bottom-3 left-4 font-mono text-[9px] text-slate-400 tracking-widest">{game.year} // {game.statusLabel.toUpperCase()}</span>
  </div>

  <div class="p-4 flex flex-col gap-2 flex-1">
    <h3 class="text-sm font-black text-white uppercase tracking-tight">{game.name}</h3>
    <p class="text-[11px] text-slate-400 font-light leading-relaxed flex-1">{game.description}</p>
    <div class="flex flex-wrap gap-1">
      {game.features.map((f) => (
        <span class="px-1.5 py-0.5 rounded bg-white/5 border border-white/5 text-[9px] font-mono text-slate-400">{f}</span>
      ))}
    </div>
    <div class="flex gap-2 pt-2">
      <a
        href={href}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener' : undefined}
        class="flex-1 text-center py-2 rounded-lg bg-gradient-to-r from-cyan-500 to-indigo-500 hover:from-cyan-400 hover:to-indigo-400 text-white font-mono text-[10px] font-bold tracking-widest uppercase transition-all active:scale-95"
      >
        {game.status === 'soon' ? 'Ver repo' : game.status === 'live' ? 'Jugar ahora' : 'Jugar'}
      </a>
      <a
        href={game.repo}
        target="_blank"
        rel="noopener"
        title="Código en GitHub"
        class="px-3 py-2 rounded-lg bg-white/5 border border-white/10 hover:border-white/25 text-slate-300 font-mono text-[10px] transition-all"
      >
        &lt;/&gt;
      </a>
    </div>
  </div>
</Panel>
