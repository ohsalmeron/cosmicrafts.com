---
import { GAMES } from '../data/games';

/**
 * Home games grid — 1:1 markup port of the Vue DAO Games.vue cards.
 * Clicking a playable card opens the game directly on its /play route.
 */
---
<link rel="stylesheet" href="/assets/css/games-vue.css" />

<section id="juegos" class="games-home">
  <div class="games-home-head">
    <h2 data-i18n="games.title">Our Games</h2>
    <a href="/games" class="games-home-more">→</a>
  </div>
  <div class="games-grid">
    {GAMES.map((g) => (
      <a class="game-card" href={g.status === 'soon' ? undefined : (g.playRoute || g.externalUrl)} aria-disabled={g.status === 'soon' ? 'true' : undefined}>
        <div class="game-image">
          <div class={`game-badge ${g.badgeClass}`}>{g.badge}</div>
          <img src={g.image} alt={g.name} loading="lazy" />
        </div>
        <div class="game-info">
          <h3 class="game-title">{g.name} ({g.year})</h3>
          <p class="game-description">{g.description}</p>
          <div class="game-meta">
            <span class="release-date">{g.release}</span>
            <span class="game-type">{g.genre}</span>
          </div>
          <div class="game-features">
            {g.features.map((f) => <span class="feature">{f}</span>)}
          </div>
        </div>
        <div class="game-cta">
          <span class="play-button">{g.status === 'soon' ? g.statusLabel : `Play ${g.name}`}</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .games-home { max-width: 1200px; margin: 0 auto; padding: 3rem 1rem; }
  .games-home-head { display: flex; align-items: center; justify-content: space-between; padding: 0 1rem; }
  .games-home-head h2 { font-size: 2rem; font-weight: 900; color: var(--cosmic-text-primary, #fff); margin: 0; }
  .games-home-more { color: var(--cosmic-blue-light, #4fd2ff); font-size: 1.5rem; text-decoration: none; min-height: 44px; min-width: 44px; display: inline-flex; align-items: center; justify-content: center; }
  .games-home .games-grid { padding: 1rem; }
  .game-card { text-decoration: none; display: block; }
  .game-card[aria-disabled="true"] { cursor: default; opacity: 0.85; }
  .game-card[aria-disabled="true"]:hover { transform: none; }
  .game-badge.live { background: linear-gradient(135deg, #00e5ff, #2979ff); color: white; }
  .game-badge.new { background: linear-gradient(135deg, #00e676, #00b0ff); color: white; }
</style>
