---
import Panel from './Panel.astro';
import GameCard from './GameCard.astro';
import { GAMES, BATTLEGROUNDS } from '../data/games';

const featured = GAMES.slice(0, 3);
const classics = GAMES.slice(3);
---

<section id="juegos" class="w-full max-w-7xl mx-auto z-10 px-1 pt-14 pb-4">
  <div class="flex items-end justify-between mb-5">
    <div>
      <p class="font-mono text-[10px] text-cyan-400 tracking-[0.3em] uppercase mb-1">[ GAME_LIBRARY ]</p>
      <h2 class="text-2xl md:text-4xl font-black text-white uppercase tracking-tight text-balance">Juegos</h2>
      <p class="text-xs md:text-sm text-slate-400 font-light mt-1">Del clásico 2019 a los nuevos de 2026. Elige y juega.</p>
    </div>
    <a href="/games" class="hidden sm:inline-block font-mono text-[10px] text-slate-400 hover:text-cyan-300 tracking-widest uppercase border border-white/10 hover:border-cyan-400/40 rounded-lg px-3 py-2 transition-[color,border-color]">
      Ver todos →
    </a>
  </div>

  <!-- Destacados 2026 + live -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    {featured.map((g, i) => <GameCard game={g} index={i} />)}
  </div>

  <!-- Clásicos DAO -->
  <p class="font-mono text-[10px] text-slate-500 tracking-[0.3em] uppercase mt-8 mb-3">[ CLASSICS_FROM_DAO ]</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
    {classics.map((g, i) => <GameCard game={g} index={i} />)}
  </div>

  <!-- Battlegrounds banner -->
  <Panel variant="purple" class="mt-6 overflow-hidden">
    <div class="relative flex flex-col md:flex-row items-center gap-5 p-5 md:p-6">
      <img src={BATTLEGROUNDS.image} alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-25 pointer-events-none" />
      <img src={BATTLEGROUNDS.logo} alt="Battlegrounds" width="128" height="128" loading="lazy" class="relative w-24 h-24 md:w-32 md:h-32 object-contain rounded-xl shrink-0" />
      <div class="relative flex-1 text-center md:text-left">
        <p class="font-mono text-[9px] text-purple-300 tracking-[0.3em] uppercase mb-1">[ NEXT_EVOLUTION ]</p>
        <h3 class="text-lg md:text-2xl font-black text-white uppercase tracking-tight text-balance">{BATTLEGROUNDS.name}</h3>
        <p class="text-[11px] md:text-xs text-slate-300 font-light mt-1">{BATTLEGROUNDS.description}</p>
        <div class="flex flex-col sm:flex-row gap-2 mt-4 justify-center md:justify-start">
          <a href={BATTLEGROUNDS.epicUrl} target="_blank" rel="noopener" class="inline-flex items-center justify-center min-h-[44px] px-4 py-2 rounded-lg bg-gradient-to-r from-cyan-500 to-indigo-500 hover:from-cyan-400 hover:to-indigo-400 text-white font-mono text-[10px] font-bold tracking-widest uppercase transition-[background-color,transform] active:scale-95 text-center">
            Wishlist en Epic
          </a>
          <a href={BATTLEGROUNDS.itchUrl} target="_blank" rel="noopener" class="inline-flex items-center justify-center min-h-[44px] px-4 py-2 rounded-lg bg-white/5 border border-white/10 hover:border-purple-400/40 text-white font-mono text-[10px] font-bold tracking-widest uppercase transition-[border-color] text-center">
            Demo en itch.io
          </a>
        </div>
      </div>
    </div>
  </Panel>
</section>
