---
---

<div id="wou-auth-modal" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md">
  <div class="relative w-full max-w-md bg-slate-950/95 border border-cyan-500/20 rounded-2xl shadow-[0_0_60px_rgba(6,182,212,0.15)] p-6 sm:p-8 overflow-hidden text-white">
    <!-- Glow Effects -->
    <div class="absolute -top-24 -right-24 w-48 h-48 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-indigo-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Modal Header -->
    <div class="flex items-center justify-between mb-5 border-b border-white/5 pb-3">
      <div class="flex items-center gap-2.5">
        <img src="/logo.svg" alt="Cosmicrafts Logo" class="h-6 w-auto" />
        <img src="/wouid.svg" alt="WouID" class="h-4 w-auto border-l border-white/10 pl-2.5" />
        <span class="text-[9px] font-mono text-cyan-400 uppercase tracking-widest">
          WouID
        </span>
      </div>
      <button id="modal-close-btn" type="button" class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-white/10 transition-colors" aria-label="Close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Title / Subtitle -->
    <div class="mb-5 text-left">
      <h2 id="modal-title" class="text-xl font-black uppercase tracking-tight text-white">Connect to Cosmicrafts</h2>
      <p id="modal-subtitle" class="text-xs text-slate-400 mt-1 font-light">
        Authenticate via World of Unreal Identity to link cross-game profiles and assets.
      </p>
    </div>

    <!-- Alert / Error Banner -->
    <div id="modal-error" class="hidden mb-4 p-3 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs flex items-center gap-2">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <span id="modal-error-msg"></span>
    </div>

    <!-- Tab Selector -->
    <div id="modal-tabs" class="flex p-1 bg-slate-900 border border-white/10 rounded-xl mb-5 text-[11px] font-mono">
      <button id="tab-btn-web3" type="button" class="flex-1 py-1.5 font-bold rounded-lg bg-cyan-500 text-slate-950 shadow-md transition-all cursor-pointer">
        Web3 Wallets
      </button>
      <button id="tab-btn-email" type="button" class="flex-1 py-1.5 font-bold rounded-lg text-slate-400 hover:text-white transition-all cursor-pointer">
        Email OTP
      </button>
      <button id="tab-btn-social" type="button" class="flex-1 py-1.5 font-bold rounded-lg text-slate-400 hover:text-white transition-all cursor-pointer">
        Social
      </button>
    </div>

        <!-- QR SIGN-IN (same flow everywhere: scan, approve on phone, this device enters) -->
    <div id="qr-box" class="mb-5 p-3 rounded-xl border border-white/10 bg-white/[0.03] flex items-center gap-3">
      <div id="qr-idle" class="flex-1 flex items-center gap-2">
        <div class="flex-1">
          <div class="text-xs font-bold text-white">Scan to sign in</div>
          <input id="qr-user" placeholder="@username for push (optional)" class="mt-1 w-full px-2 py-1 rounded-lg bg-black/40 border border-white/10 text-[11px] font-mono text-white placeholder-zinc-600 focus:outline-none" />
        </div>
        <button id="qr-start" type="button" class="px-3 py-1.5 rounded-lg bg-cyan-500 text-slate-950 text-[11px] font-mono font-bold uppercase hover:bg-cyan-400 transition-all cursor-pointer">Show link</button>
      </div>
      <div id="qr-view" class="hidden flex-1">
        <div class="text-xs font-bold text-white">Open on your phone</div>
        <div class="flex items-center gap-2 mt-1">
          <input id="qr-link" readonly class="flex-1 px-2 py-1 rounded-lg bg-black/40 border border-white/10 text-[11px] font-mono text-zinc-300 focus:outline-none" />
          <button id="qr-copy" type="button" class="px-3 py-1 rounded-lg bg-white/5 border border-white/10 text-white text-[11px] font-mono font-bold hover:bg-white/10 transition-all cursor-pointer">Copy</button>
        </div>
        <div class="flex items-center gap-2 mt-1.5">
          <span id="qr-timer" class="text-[11px] font-mono text-zinc-500"></span>
          <button id="qr-cancel" type="button" class="text-[11px] text-zinc-400 hover:text-white ml-auto">Cancel</button>
        </div>
      </div>
    </div>

    <!-- TAB 1: WEB3 WALLETS -->
    <div id="tab-content-web3" class="space-y-2.5">
      <!-- EVM / MetaMask -->
      <button id="web3-evm" type="button" class="w-full py-2.5 px-4 rounded-xl bg-white/5 border border-white/10 hover:border-cyan-400/40 hover:bg-cyan-950/20 text-white text-xs font-mono font-bold flex items-center justify-between transition-all group cursor-pointer">
        <div class="flex items-center gap-3">
          <div class="w-6 h-6 rounded-lg bg-amber-500/20 border border-amber-500/30 flex items-center justify-center font-bold text-amber-300 text-xs">Ξ</div>
          <span>ETHEREUM / EVM (METAMASK)</span>
        </div>
        <span class="text-[9px] text-cyan-400 uppercase">[ CONNECT ]</span>
      </button>

      <!-- Solana / Phantom -->
      <button id="web3-solana" type="button" class="w-full py-2.5 px-4 rounded-xl bg-white/5 border border-white/10 hover:border-purple-400/40 hover:bg-purple-950/20 text-white text-xs font-mono font-bold flex items-center justify-between transition-all group cursor-pointer">
        <div class="flex items-center gap-3">
          <div class="w-6 h-6 rounded-lg bg-purple-500/20 border border-purple-500/30 flex items-center justify-center font-bold text-purple-300 text-xs">S</div>
          <span>SOLANA (PHANTOM / BACKPACK)</span>
        </div>
        <span class="text-[9px] text-purple-400 uppercase">[ CONNECT ]</span>
      </button>

      <!-- ICP -->
      <button id="web3-icp" type="button" class="w-full py-2.5 px-4 rounded-xl bg-white/5 border border-white/10 hover:border-cyan-400/40 hover:bg-cyan-950/20 text-white text-xs font-mono font-bold flex items-center justify-between transition-all group cursor-pointer">
        <div class="flex items-center gap-3">
          <div class="w-6 h-6 rounded-lg bg-cyan-500/20 border border-cyan-500/30 flex items-center justify-center font-bold text-cyan-300 text-xs">∞</div>
          <span>INTERNET IDENTITY / ICP</span>
        </div>
        <span class="text-[9px] text-cyan-400 uppercase">[ CONNECT ]</span>
      </button>
    </div>

    <!-- TAB 2: EMAIL OTP -->
    <div id="tab-content-email" class="hidden space-y-4">
      <form id="form-request-otp" class="space-y-4 text-left">
        <div>
          <label for="wou-input-email" class="block text-[10px] font-mono uppercase tracking-wider text-slate-400 mb-1.5">
            Commander Email Address
          </label>
          <input
            id="wou-input-email"
            type="email"
            required
            placeholder="name@example.com"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-white/15 text-white placeholder-slate-500 text-xs focus:outline-none focus:border-cyan-400 transition-all font-mono"
          />
        </div>

        <div class="flex items-center gap-2 pt-1">
          <input id="wou-input-newsletter" type="checkbox" checked class="w-3.5 h-3.5 rounded bg-slate-900 border-white/20 text-cyan-500 focus:ring-cyan-400 cursor-pointer" />
          <label for="wou-input-newsletter" class="text-[10px] text-slate-400 cursor-pointer select-none">
            Receive battle alerts & fleet dispatch notes
          </label>
        </div>

        <button
          id="btn-submit-email"
          type="submit"
          class="w-full py-2.5 px-4 mt-2 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs font-mono uppercase tracking-wider transition-all flex items-center justify-center gap-2 shadow-lg shadow-cyan-500/20 cursor-pointer"
        >
          <span>Send Verification Code</span>
        </button>
      </form>

      <form id="form-verify-otp" class="hidden space-y-4">
        <div>
          <label class="block text-[10px] font-mono uppercase tracking-wider text-slate-400 mb-3 text-center">
            6-Digit Security Code
          </label>
          <div class="flex justify-between gap-1.5">
            <input type="text" inputmode="numeric" maxlength="1" class="otp-digit w-11 h-12 text-center text-lg font-mono font-bold bg-slate-900 border border-white/20 rounded-xl focus:outline-none focus:border-cyan-400 text-white" />
            <input type="text" inputmode="numeric" maxlength="1" class="otp-digit w-11 h-12 text-center text-lg font-mono font-bold bg-slate-900 border border-white/20 rounded-xl focus:outline-none focus:border-cyan-400 text-white" />
            <input type="text" inputmode="numeric" maxlength="1" class="otp-digit w-11 h-12 text-center text-lg font-mono font-bold bg-slate-900 border border-white/20 rounded-xl focus:outline-none focus:border-cyan-400 text-white" />
            <input type="text" inputmode="numeric" maxlength="1" class="otp-digit w-11 h-12 text-center text-lg font-mono font-bold bg-slate-900 border border-white/20 rounded-xl focus:outline-none focus:border-cyan-400 text-white" />
            <input type="text" inputmode="numeric" maxlength="1" class="otp-digit w-11 h-12 text-center text-lg font-mono font-bold bg-slate-900 border border-white/20 rounded-xl focus:outline-none focus:border-cyan-400 text-white" />
            <input type="text" inputmode="numeric" maxlength="1" class="otp-digit w-11 h-12 text-center text-lg font-mono font-bold bg-slate-900 border border-white/20 rounded-xl focus:outline-none focus:border-cyan-400 text-white" />
          </div>
        </div>

        <button
          id="btn-submit-otp"
          type="submit"
          class="w-full py-2.5 px-4 rounded-xl bg-cyan-400 text-slate-950 font-bold text-xs font-mono uppercase tracking-wider hover:bg-cyan-300 transition-all flex items-center justify-center gap-2 shadow-lg cursor-pointer"
        >
          <span>Verify & Connect</span>
        </button>

        <div class="flex items-center justify-between text-[10px] font-mono text-slate-400 pt-1">
          <button id="btn-change-email" type="button" class="hover:text-white transition-colors cursor-pointer">
            ← Change Email
          </button>
          <button id="btn-resend-otp" type="button" class="text-cyan-400 hover:underline cursor-pointer">
            Resend Code
          </button>
        </div>
      </form>
    </div>

    <!-- TAB 3: SOCIAL -->
    <div id="tab-content-social" class="hidden space-y-2 text-xs font-mono">
      <button data-provider="discord" class="social-btn w-full py-2.5 px-4 rounded-xl bg-[#5865F2]/15 border border-[#5865F2]/30 hover:bg-[#5865F2]/25 text-white flex items-center justify-between transition-all cursor-pointer">
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 fill-current text-[#5865F2]" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
          <span>DISCORD AUTH</span>
        </div>
        <span class="text-[9px] text-slate-500">[ INSTANT ]</span>
      </button>

      <button data-provider="google" class="social-btn w-full py-2.5 px-4 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 text-white flex items-center justify-between transition-all cursor-pointer">
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
          <span>GOOGLE ACCOUNT</span>
        </div>
        <span class="text-[9px] text-slate-500">[ INSTANT ]</span>
      </button>

      <button data-provider="twitter" class="social-btn w-full py-2.5 px-4 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 text-white flex items-center justify-between transition-all cursor-pointer">
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          <span>X / TWITTER</span>
        </div>
        <span class="text-[9px] text-slate-500">[ INSTANT ]</span>
      </button>

      <button data-provider="meta" class="social-btn w-full py-2.5 px-4 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 text-white flex items-center justify-between transition-all cursor-pointer">
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 fill-current text-[#0081FB]" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          <span>META ACCOUNT</span>
        </div>
        <span class="text-[9px] text-slate-500">[ INSTANT ]</span>
      </button>
    </div>

    <!-- Footer Notice -->
    <div class="mt-5 pt-3 border-t border-white/5 text-center">
      <p class="text-[9px] font-mono text-slate-500">
        World of Unreal Identity Network (WOU-ID)
      </p>
    </div>
  </div>
</div>

<script>
  import { wouAuth } from '@worldofunreal/id-sdk';
  wouAuth.setDefaultContext('cosmicrafts');

  const modal = document.getElementById('wou-auth-modal');
  const closeBtn = document.getElementById('modal-close-btn');
  const errorBanner = document.getElementById('modal-error');
  const errorMsg = document.getElementById('modal-error-msg');

  // Tabs
  const tabBtnWeb3 = document.getElementById('tab-btn-web3');
  const tabBtnEmail = document.getElementById('tab-btn-email');
  const tabBtnSocial = document.getElementById('tab-btn-social');
  const tabContentWeb3 = document.getElementById('tab-content-web3');
  const tabContentEmail = document.getElementById('tab-content-email');
  const tabContentSocial = document.getElementById('tab-content-social');

  // Forms
  const formRequestOtp = document.getElementById('form-request-otp') as HTMLFormElement;
  const formVerifyOtp = document.getElementById('form-verify-otp') as HTMLFormElement;
  const inputEmail = document.getElementById('wou-input-email') as HTMLInputElement;
  const inputNewsletter = document.getElementById('wou-input-newsletter') as HTMLInputElement;
  const btnChangeEmail = document.getElementById('btn-change-email');
  const btnResendOtp = document.getElementById('btn-resend-otp');
  const otpDigits = document.querySelectorAll('.otp-digit') as NodeListOf<HTMLInputElement>;

  let currentEmail = '';

  function showError(msg: string) {
    if (errorBanner && errorMsg) {
      errorMsg.textContent = msg;
      errorBanner.classList.remove('hidden');
    }
  }

  function hideError() {
    errorBanner?.classList.add('hidden');
  }

  function switchTab(tab: 'web3' | 'email' | 'social') {
    hideError();
    const activeClass = 'flex-1 py-1.5 font-bold rounded-lg bg-cyan-500 text-slate-950 shadow-md transition-all cursor-pointer';
    const inactiveClass = 'flex-1 py-1.5 font-bold rounded-lg text-slate-400 hover:text-white transition-all cursor-pointer';

    if (tabBtnWeb3) tabBtnWeb3.className = tab === 'web3' ? activeClass : inactiveClass;
    if (tabBtnEmail) tabBtnEmail.className = tab === 'email' ? activeClass : inactiveClass;
    if (tabBtnSocial) tabBtnSocial.className = tab === 'social' ? activeClass : inactiveClass;

    if (tab === 'web3') {
      tabContentWeb3?.classList.remove('hidden');
      tabContentEmail?.classList.add('hidden');
      tabContentSocial?.classList.add('hidden');
    } else if (tab === 'email') {
      tabContentWeb3?.classList.add('hidden');
      tabContentEmail?.classList.remove('hidden');
      tabContentSocial?.classList.add('hidden');
    } else {
      tabContentWeb3?.classList.add('hidden');
      tabContentEmail?.classList.add('hidden');
      tabContentSocial?.classList.remove('hidden');
    }
  }

  tabBtnWeb3?.addEventListener('click', () => switchTab('web3'));
  tabBtnEmail?.addEventListener('click', () => switchTab('email'));
  tabBtnSocial?.addEventListener('click', () => switchTab('social'));

  closeBtn?.addEventListener('click', () => {
    modal?.classList.add('hidden');
  });

  // Modal Open/Close listener
  window.addEventListener('wou:open-modal', () => {
    modal?.classList.remove('hidden');
    hideError();
    switchTab('web3');
  });

  window.addEventListener('wou:close-modal', () => {
    modal?.classList.add('hidden');
  });

  // Email Step 1: Request OTP
  formRequestOtp?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();
    const email = inputEmail.value.trim();
    if (!email) return;

    try {
      const submitBtn = document.getElementById('btn-submit-email');
      submitBtn?.setAttribute('disabled', 'true');
      submitBtn!.textContent = 'Sending Code...';

      await wouAuth.requestOtp(email);
      currentEmail = email;

      formRequestOtp.classList.add('hidden');
      formVerifyOtp.classList.remove('hidden');
      otpDigits[0]?.focus();
    } catch (err: any) {
      showError(err.message || 'Failed to send security code.');
    } finally {
      const submitBtn = document.getElementById('btn-submit-email');
      submitBtn?.removeAttribute('disabled');
      submitBtn!.textContent = 'Send Verification Code';
    }
  });

  // OTP inputs autofocus navigation
  otpDigits.forEach((digit, idx) => {
    digit.addEventListener('input', () => {
      if (digit.value.length === 1 && idx < otpDigits.length - 1) {
        otpDigits[idx + 1].focus();
      }
    });

    digit.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !digit.value && idx > 0) {
        otpDigits[idx - 1].focus();
      }
    });
  });

  // Email Step 2: Verify OTP
  formVerifyOtp?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();

    const code = Array.from(otpDigits).map(d => d.value).join('');
    if (code.length !== 6) {
      showError('Please enter the 6-digit code.');
      return;
    }

    try {
      const submitBtn = document.getElementById('btn-submit-otp');
      submitBtn?.setAttribute('disabled', 'true');
      submitBtn!.textContent = 'Authenticating...';

      await wouAuth.verifyOtp(currentEmail, code, inputNewsletter?.checked ?? true);
      modal?.classList.add('hidden');
    } catch (err: any) {
      showError(err.message || 'Invalid or expired code.');
    } finally {
      const submitBtn = document.getElementById('btn-submit-otp');
      submitBtn?.removeAttribute('disabled');
      submitBtn!.textContent = 'Verify & Connect';
    }
  });

  btnChangeEmail?.addEventListener('click', () => {
    formVerifyOtp.classList.add('hidden');
    formRequestOtp.classList.remove('hidden');
    hideError();
  });

  btnResendOtp?.addEventListener('click', async () => {
    if (!currentEmail) return;
    try {
      await wouAuth.requestOtp(currentEmail);
      alert(`New code sent to ${currentEmail}`);
    } catch (err: any) {
      showError(err.message || 'Failed to resend code.');
    }
  });

  // Social Auth
  document.querySelectorAll('.social-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const provider = btn.getAttribute('data-provider');
      if (provider) wouAuth.loginWithSocial(provider);
    });
  });

  // Web3 Auth
  document.getElementById('web3-solana')?.addEventListener('click', async () => {
    try {
      hideError();
      await wouAuth.loginWithSolana();
      modal?.classList.add('hidden');
    } catch (err: any) {
      showError(err.message || 'Solana authentication failed.');
    }
  });

  document.getElementById('web3-evm')?.addEventListener('click', async () => {
    try {
      hideError();
      await wouAuth.loginWithEvm();
      modal?.classList.add('hidden');
    } catch (err: any) {
      showError(err.message || 'MetaMask/EVM authentication failed.');
    }
  });

  document.getElementById('web3-icp')?.addEventListener('click', async () => {
    try {
      hideError();
      await wouAuth.loginWithIcp();
      modal?.classList.add('hidden');
    } catch (err: any) {
      showError(err.message || 'ICP authentication failed.');
    }
  });

  // QR sign-in (same everywhere)
  let qrState = null;
  let qrPoll = null;
  const qrBox = document.getElementById('qr-box');
  const qrIdle = document.getElementById('qr-idle');
  const qrView = document.getElementById('qr-view');
  const qrLink = document.getElementById('qr-link');
  const qrTimer = document.getElementById('qr-timer');
  function qrStop() { if (qrPoll) clearInterval(qrPoll); qrPoll = null; }
  document.getElementById('qr-start')?.addEventListener('click', async () => {
    hideError();
    try {
      const u = (document.getElementById('qr-user') as HTMLInputElement)?.value.trim() || undefined;
      const q = await wouAuth.startQr({ username: u });
      qrState = q;
      (qrLink as HTMLInputElement).value = q.approve_url;
      qrIdle?.classList.add('hidden'); qrView?.classList.remove('hidden');
      let left = q.expires_in_seconds;
      const tick = () => { if (qrTimer) qrTimer.textContent = Math.floor(left / 60) + ':' + String(left % 60).padStart(2, '0') + (q.notified?.length ? ' · push: ' + q.notified.join(', ') : ''); };
      tick();
      qrStop();
      qrPoll = setInterval(async () => {
        left -= 2;
        try {
          const s = await wouAuth.qrStatus(q.id, q.secret);
          if (s.status === 'approved' && s.session_token && s.account) {
            qrStop();
            wouAuth.setSession(s.session_token, s.account);
            window.location.reload();
            return;
          }
          if (s.status === 'expired') { qrStop(); qrState = null; qrIdle?.classList.remove('hidden'); qrView?.classList.add('hidden'); showError('Code expired.'); return; }
        } catch {}
        tick();
      }, 2000);
    } catch (err: any) { showError(err.message || 'QR failed.'); }
  });
  document.getElementById('qr-copy')?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText((qrLink as HTMLInputElement).value); } catch {}
  });
  document.getElementById('qr-cancel')?.addEventListener('click', async () => {
    if (qrState) { try { await wouAuth.qrCancel(qrState.id, qrState.secret); } catch {} }
    qrStop(); qrState = null; qrIdle?.classList.remove('hidden'); qrView?.classList.add('hidden');
  });
</script>
